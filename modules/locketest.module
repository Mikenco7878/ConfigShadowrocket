#!name=Locket AI Test Companion
# Updated: 02:48 11/11/2026 (UTC+7)
#!desc=Bo sung chan doan tao anh cho mikenco0711; giu nguyen luong Remote Config cua module goc.

# Enable alongside mikenco0711.module; disable the older Locket Test and update.module.
# Raw script must be published before importing this module from GitHub.
# No Firebase or RevenueCat hooks: the working base module retains ownership.
# No body buffering, subscription changes or third-party image redirects.

[Rule]
# Restrict UDP rejection to the two original image-generation hosts.
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,us-central1-locket-4252a.cloudfunctions.net),(PROTOCOL,UDP)),REJECT

[Script]
locket_test_api_request = type=http-request,pattern=^https:\/\/(?:api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/generateFilteredImage(?:\?[^#]*)?$,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/main/scripts/remote.js?v=20261111_0248
locket_test_api_response = type=http-response,pattern=^https:\/\/(?:api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/generateFilteredImage(?:\?[^#]*)?$,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/main/scripts/remote.js?v=20261111_0248

[MITM]
enable = true
hostname = %APPEND% api.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net
