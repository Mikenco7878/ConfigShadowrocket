#!name=Locket Test
#!desc=Chan doan Remote Config, profile va tao anh Locket; khong thay the backend AI.

# Run separately from update.module and other Locket hooks.
# Raw script must be published before importing this module from GitHub.
# No body buffering: images, credentials and server payloads stay unchanged.

[Script]
locket_test_config_request = type=http-request,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch(?:\?[^#]*)?$,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/main/scripts/remote.js
locket_test_config_response = type=http-response,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch(?:\?[^#]*)?$,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/main/scripts/remote.js
locket_test_api_request = type=http-request,pattern=^https:\/\/(?:(?:api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/generateFilteredImage|api\.locketcamera\.com\/changeProfileInfo)(?:\?[^#]*)?$,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/main/scripts/remote.js
locket_test_api_response = type=http-response,pattern=^https:\/\/(?:(?:api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/generateFilteredImage|api\.locketcamera\.com\/changeProfileInfo)(?:\?[^#]*)?$,requires-body=false,timeout=10,script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/main/scripts/remote.js

[MITM]
hostname = %APPEND% firebaseremoteconfig.googleapis.com, api.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net
