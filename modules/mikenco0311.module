#!name=Locket Gold new version
#!desc=Locket, Youtube, Spotify, SoundCloud
# Author: Mikenco7878
# Updated: 03-11-2026

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 26.3; Scale/3.00)

[Script]

# ~ Locket Gold
# RevenueCat Response
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/main/scripts/revenuecat.js, requires-body=true, max-size=-1, timeout=60
# RevenueCat Request Header
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/main/scripts/deleteHeader.js, timeout=60
# Locket Firebase Remote Config
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/main/scripts/forceLocketGold.js?v=20261103-2, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com