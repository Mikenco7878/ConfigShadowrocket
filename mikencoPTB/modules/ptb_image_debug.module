# Enable only during a short reproduction. Can be used alongside mkc.sgmodule.
# Bodies above 2 MiB may bypass these hooks. Never raise the limit to unlimited.
[Script]
mkc_ptb_image_request = type=http-request,pattern=^https:\/\/(?:api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/(?:generateFilteredImage|applyFilter)(?:\?[^#]*)?$,requires-body=true,max-size=2097152,timeout=10,argument=metadata,script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/refs/heads/feat/mikenco-ptb-mvp/mikencoPTB/scripts/ptb_image_metadata.js?v=20261123_m0_m1_05
mkc_ptb_image_response = type=http-response,pattern=^https:\/\/(?:api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/(?:generateFilteredImage|applyFilter)(?:\?[^#]*)?$,requires-body=true,max-size=2097152,timeout=10,argument=metadata,script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/refs/heads/feat/mikenco-ptb-mvp/mikencoPTB/scripts/ptb_image_metadata.js?v=20261123_m0_m1_05

[MITM]
hostname = %APPEND% api.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net
