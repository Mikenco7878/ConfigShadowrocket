#!name=MKC PTB Image Metadata (M1)
#!desc=Bounded metadata collection for candidate image endpoints. No redirect or image modification; endpoints unverified on device.
# Build: 20261123_m0_m1_02

# Enable only during a short reproduction. Can be used alongside mkc.sgmodule.
# Bodies above 2 MiB may bypass these hooks. Never raise the limit to unlimited.
[Script]
mkc_ptb_image_request = type=http-request,pattern=^https:\/\/(?:api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/(?:generateFilteredImage|applyFilter)(?:\?[^#]*)?$,requires-body=true,max-size=2097152,timeout=10,argument=metadata,script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/feat/mikenco-ptb-mvp/mikencoPTB/scripts/ptb_image_metadata.js?v=20261123_m0_m1_02
mkc_ptb_image_response = type=http-response,pattern=^https:\/\/(?:api\.locketcamera\.com|us-central1-locket-4252a\.cloudfunctions\.net)\/(?:generateFilteredImage|applyFilter)(?:\?[^#]*)?$,requires-body=true,max-size=2097152,timeout=10,argument=metadata,script-path=https://raw.githubusercontent.com/Mikenco7878/ConfigShadowrocket/feat/mikenco-ptb-mvp/mikencoPTB/scripts/ptb_image_metadata.js?v=20261123_m0_m1_02

[MITM]
hostname = %APPEND% api.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net
